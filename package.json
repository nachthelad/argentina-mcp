{
  "name": "argentina-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:properties": "vitest run --config vitest.properties.config.ts",
    "smoke": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.18",
    "mcp-handler": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
